rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && userId == request.auth.uid;
      allow update, delete: if signedIn() && userId == request.auth.uid;
    }

    match /accounts/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Retorna true se a conta (por ID) pertence ao usuário autenticado
    function ownsAccount(accountId) {
      return get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid;
    }

    match /transactions/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming()
        && ownsAccount(request.resource.data.accountId)
        && (!("destinationAccountId" in request.resource.data)
            || request.resource.data.destinationAccountId == null
            || request.resource.data.destinationAccountId == ""
            || ownsAccount(request.resource.data.destinationAccountId));
      allow update: if ownsExisting() && ownsIncoming()
        && ownsAccount(request.resource.data.accountId)
        && (!("destinationAccountId" in request.resource.data)
            || request.resource.data.destinationAccountId == null
            || request.resource.data.destinationAccountId == ""
            || ownsAccount(request.resource.data.destinationAccountId));
    }

    match /categories/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /goals/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /budgets/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /creditCards/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
